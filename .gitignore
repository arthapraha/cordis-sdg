# Snapshot payloads are not committed. Their sha256 hashes are in
# data/manifest.json, which is committed, so a re-download can be verified
# byte for byte without carrying ~180 MB of data in git history.
data/raw/

# Python
__pycache__/
*.pyc
.venv/

# The hand-off artefact is uploaded to the room by hash, not carried in git:
# it is a 1 MB derivative of payload that is itself not committed, and the
# labellers fetch it from the vault. draw.json and the two id lists ARE
# committed, because the draw must be checkable from the repository alone.
data/sample/handoff-150.json

# Pipeline output goes to the room as an artefact by hash, like the hand-off.
# The parameters and the code are committed; the scores are not, because
# registration section 4 keeps the labellers blind to them.
data/pipeline/development-50-v1.json
data/pipeline/development-50-explanations-v1.json
